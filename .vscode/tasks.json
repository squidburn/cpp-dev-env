{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cpprun",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "-I",
                "${workspaceFolder}/include/",
                "-o",
                "${workspaceFolder}/build/buildcpp",
                "-O2",
                "-std=c++14",
                "-static",

                //"-mwindows"
            ], // 编译命令参数
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "\\"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ],
}